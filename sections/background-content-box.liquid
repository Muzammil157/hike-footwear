<section 
  class="bg-content-section alignment-{{ section.settings.content_alignment }}"
  style="
    background-image: url({{ section.settings.bg_image | image_url: width: 2000 }});
  "
>
  <!-- Overlay -->
  <div 
    class="bg-overlay"
    style="
      background-color: {{ section.settings.overlay_color }};
      opacity: {{ section.settings.overlay_opacity }};
      display: block;
    "
  ></div>

  <div class="bg-content-wrapper">
    <div class="bg-content-box">

      {% if section.settings.heading != blank %}
        <h2 
          class="bg-heading"
          style="color: {{ section.settings.heading_color }};"
        >
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div 
          class="bg-text"
          style="color: {{ section.settings.text_color }};"
        >
          {{ section.settings.text }}
        </div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a 
          href="{{ section.settings.button_link }}" 
          class="bg-button"
          style="
            color: {{ section.settings.button_text_color }};
            background-color: {{ section.settings.button_bg_color }};
            border: 1px solid {{ section.settings.button_border_color }};
          "
        >
          {{ section.settings.button_label }}
        </a>
      {% endif %}

    </div>
  </div>
</section>

<style>
/* Reset */
.bg-content-section,
.bg-content-section * {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* Section Base */
.bg-content-section {
  width: 100%;
  position: relative;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

/* Overlay */
.bg-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
}

/* Wrapper */
.bg-content-wrapper {
  position: relative;
  z-index: 2;
  display: flex;
  width: 100%;
}

/* Alignment */
.alignment-left .bg-content-wrapper {
  justify-content: flex-start;
}

.alignment-center .bg-content-wrapper {
  justify-content: center;
}

.alignment-right .bg-content-wrapper {
  justify-content: flex-end;
}

/* Content Box */
.bg-content-box {
  max-width: 500px;
  padding: 40px;
}

/* Heading */
.bg-heading {
  margin-bottom: 15px;
}

/* Text */
.bg-text {
  margin-bottom: 20px;
}

/* Button */
.bg-button {
  display: inline-block;
  text-decoration: none;
  padding: 10px 20px;
}
</style>

{% schema %}
{
  "name": "Background Content Box",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.4
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Heading Here"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Add your content text here."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button Border Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Background Content Box"
    }
  ]
}
{% endschema %}