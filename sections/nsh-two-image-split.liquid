{% comment %}
NSH Two Image Split Section
{% endcomment %}

<section class="nsh-two-image-split">
  <div class="nsh-two-image-wrapper">

    <!-- LEFT IMAGE -->
    <div class="nsh-image-item nsh-left">
      {% if section.settings.left_image != blank %}
        <img 
          src="{{ section.settings.left_image | image_url: width: 2000 }}"
          alt="{{ section.settings.left_image.alt | escape }}"
          loading="lazy"
        >
      {% endif %}
    </div>

    <!-- RIGHT IMAGE -->
    <div class="nsh-image-item nsh-right">
      {% if section.settings.right_image != blank %}
        <img 
          src="{{ section.settings.right_image | image_url: width: 2000 }}"
          alt="{{ section.settings.right_image.alt | escape }}"
          loading="lazy"
        >
      {% endif %}
    </div>

  </div>
</section>

<style>
.nsh-two-image-split {
  width: 100%;
  padding-block: 40px;
  background-color: #f8faf8;
}

.nsh-two-image-wrapper {
  display: flex;
  gap: 32px;
  padding-inline: 27px;
}

.nsh-image-item {
  flex: 1;
  overflow: hidden;
}

.nsh-image-item img {
  width: 100%;
  height: {{ section.settings.section_height }}px;
  object-fit: contain;
  display: block;
  border-radius: 6px;
}

/* Mobile */
@media screen and (max-width: 768px) {
  .nsh-two-image-wrapper {
    flex-direction: column;
  }

  .nsh-image-item img {
    height: {{ section.settings.mobile_height }}px;
  }
}
</style>

{% schema %}
{
  "name": "NSH Two Image Split",
  "settings": [
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left Image"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right Image"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section Height (Desktop)",
      "min": 200,
      "max": 900,
      "step": 50,
      "default": 500
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Section Height (Mobile)",
      "min": 200,
      "max": 700,
      "step": 50,
      "default": 400
    }
  ],
  "presets": [
    {
      "name": "NSH Two Image Split"
    }
  ]
}
{% endschema %}