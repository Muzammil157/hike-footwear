<section class="comparison-table-section">
  <div class="comparison-container">

    <!-- Product Header Images -->
    <div class="comparison-products-header sm-hide-comparison">
      <div class="comparison-heading-box">
       <!-- Subheading -->
      {% if section.settings.subheading != blank %}
      <div class="comparison-subheading">
        {{ section.settings.subheading }}
      </div>
      {% endif %}
      {% if section.settings.subtle != blank %}
      <div class="comparison-subtle">
        {{ section.settings.subtle }}
      </div>
      {% endif %}
      </div>
      {% for block in section.blocks %}
        {% if block.type == 'product_column' %}
          <div class="comparison-product-column">
            {% if block.settings.product_image != blank %}
              <img src="{{ block.settings.product_image | image_url: width: 300 }}" alt="{{ block.settings.product_title }}" class="product-image">
            {% endif %}
            {% if block.settings.product_title != blank %}
              <div class="product-title">
                {{ block.settings.product_title }}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Rows -->
    <div class="comparison-rows-wrapper">
      <div class="comparison-row lg-hide-row">
      <div class="comparison-products-header lg-hide-comparison">
      <div class="comparison-heading-box">
       <!-- Subheading -->
      {% if section.settings.subheading != blank %}
      <div class="comparison-subheading">
        {{ section.settings.subheading }}
      </div>
      {% endif %}
      {% if section.settings.subtle != blank %}
      <div class="comparison-subtle">
        {{ section.settings.subtle }}
      </div>
      {% endif %}
      </div>
      {% for block in section.blocks %}
        {% if block.type == 'product_column' %}
          <div class="comparison-product-column">
            {% if block.settings.product_image != blank %}
              <img src="{{ block.settings.product_image | image_url: width: 300 }}" alt="{{ block.settings.product_title }}" class="product-image">
            {% endif %}
            {% if block.settings.product_title != blank %}
              <div class="product-title">
                {{ block.settings.product_title }}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
      {% for row in section.blocks %}
        {% if row.type == 'row' %}
          <div class="comparison-row">

            <!-- Row Heading -->
            <div class="row-heading">
              {{ row.settings.row_heading }}
            </div>

            <!-- Product 1 Bars -->
            {% if row.settings.product_1_bars != blank %}
              <div class="row-bars">
                {% for i in (1..5) %}
                  <span class="bar {% if i <= row.settings.product_1_bars %}filled{% endif %}"></span>
                {% endfor %}
              </div>
            {% endif %}

            <!-- Product 2 Bars -->
            {% if row.settings.product_2_bars != blank %}
              <div class="row-bars">
                {% for i in (1..5) %}
                  <span class="bar {% if i <= row.settings.product_2_bars %}filled{% endif %}"></span>
                {% endfor %}
              </div>
            {% endif %}

            <!-- Product 3 Bars -->
            {% comment %} {% if row.settings.product_3_bars != blank %}
              <div class="row-bars">
                {% for i in (1..5) %}
                  <span class="bar {% if i <= row.settings.product_3_bars %}filled{% endif %}"></span>
                {% endfor %}
              </div>
            {% endif %} {% endcomment %}

          </div>
        {% endif %}
      {% endfor %}
       <div class="comparison-product-links lg-hide-comparison">
      {% for block in section.blocks %}
        {% if block.type == 'product_column' %}
          <div class="product-link" style="grid-column-start: {{ forloop.index | plus:1 }}">
            {% if block.settings.product_link != blank %}
              <a href="{{ block.settings.product_link }}">Mehr erfahren</a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
    </div>

    <!-- Product Links -->
    <div class="comparison-product-links sm-hide-comparison">
      {% for block in section.blocks %}
        {% if block.type == 'product_column' %}
          <div class="product-link" style="grid-column-start: {{ forloop.index | plus:1 }}">
            {% if block.settings.product_link != blank %}
              <a href="{{ block.settings.product_link }}">Mehr erfahren</a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

<style>
/* Reset */
.comparison-table-section,
.comparison-table-section * {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* Section Base */
.comparison-table-section {
  width: 100%;
  overflow-x: auto;
  background: #F2F8D6;
  padding: 48px;
}

.comparison-container {
  {% comment %} max-width: 90rem; {% endcomment %}
  margin: auto;
  padding: 48px 27px;
  background: #96873B;
  border-radius: 8px;
  color: #F2F8D6;
}

.comparison-heading-box {
  display: flex;
    flex-direction: column;
    {% comment %} max-width: 33rem; {% endcomment %}
    gap: 10px;
}

/* Subheading */
.comparison-subheading {
  font-weight: 600;
  font-size: 30px;
  color: #F2F8D6;
  margin: 0;
  line-height: 28px;
}

/* Product Header Images */
.comparison-products-header {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.sm-hide-comparison {
  display: grid;
}
.lg-hide-comparison {
  display: none !important;
}

.comparison-product-column {
  flex: 1;
  text-align: center;
}

.product-image {
  width: 100%;
  max-width: 150px;
  height: auto;
}

.product-title {
  margin-top: 10px;
  font-weight: 600;
  color: #F2F8D6;
}

/* Rows */
.comparison-rows-wrapper {
  display: flex;
  flex-direction: column;
  border-top: 1px solid #ccc;
  color: #000;
  {% comment %} border-bottom: 1px solid #ccc; {% endcomment %}
}

.comparison-row {
  display: flex;
  align-items: center;
  border-bottom: 1px solid #ccc;
  padding: 15px 0;
}

.row-heading {
  flex: 1;
  font-weight: 500;
  padding-right: 10px;
  color: #F2F8D6;
}

/* Bars */
.row-bars {
  flex: 1;
  display: flex;
  justify-content: center;
  gap: 4px;
}

.bar {
  width: 18px;
  height: 10px;
  background-color: #ccc;
  border-radius: 2px;
  display: inline-block;
}

.bar.filled {
  background-color: #F2F8D6;
}

/* Product Links */
.comparison-product-links {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  justify-content: space-between;
  margin-top: 20px;
}

.product-link {
  flex: 1;
  text-align: center;
}

.product-link a {
  text-decoration: underline;
  color: #F2F8D6;
  font-weight: 600;
}

.lg-hide-row {
  display: none;
}

/* Mobile */
@media screen and (max-width: 749px) {
  .lg-hide-row {
    display: flex;
  }
  .comparison-rows-wrapper {
    border-top: none;
  }
  .sm-hide-comparison {
    display: none;
  }
  .lg-hide-comparison {
    display: grid !important;
  }
  .comparison-subheading {
    font-size: 20px;
    line-height: 22px;
  }
  .comparison-subtle {
    font-size: 14px;
    line-height: 20px;
    color: #F2F8D6;
  }
  .comparison-table-section {
    padding: 0;
  }
  .comparison-container {
    padding: 48px 16px;
  }
  .comparison-rows-wrapper {
    display: block;
    overflow-x: auto;
  }
  .comparison-row {
    display: flex;
    min-width: 655px; /* scrollable horizontally */
  }
  .comparison-product-links {
    min-width: 670px;
  }
}
</style>

{% schema %}
{
  "name": "Product Comparison Table",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Heading",
      "default": "Compare Our Products"
    },
    {
      "type": "text",
      "id": "subtle",
      "label": "Subheading"
    }
  ],
  "blocks": [
    {
      "type": "product_column",
      "name": "Product Column",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product Image"
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "Product Title"
        },
        {
          "type": "url",
          "id": "product_link",
          "label": "Product Page Link"
        }
      ]
    },
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "row_heading",
          "label": "Row Heading",
          "default": "Comfort"
        },
        {
          "type": "range",
          "id": "product_1_bars",
          "label": "Product 1 Bars",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "range",
          "id": "product_2_bars",
          "label": "Product 2 Bars",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 3
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Comparison Table",
      "blocks": [
        { "type": "product_column" },
        { "type": "product_column" },
        { "type": "product_column" },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}