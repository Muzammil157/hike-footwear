{% comment %}
NSH Logo Slider Section
{% endcomment %}

<section 
  class="nsh-logo-slider" 
  style="background-color: {{ section.settings.bg_color }};"
>
  <div class="page-width">
    <div class="nsh-logo-wrapper">
      <div class="nsh-logo-track">
        {% for block in section.blocks %}
          <div class="nsh-logo-item" {{ block.shopify_attributes }}>
            {% if block.settings.logo != blank %}
              <img 
                src="{{ block.settings.logo | image_url: width: 400 }}" 
                alt="{{ block.settings.logo.alt | escape }}"
                loading="lazy"
              >
            {% endif %}
          </div>
        {% endfor %}

        {%- comment -%}
        Duplicate logos for infinite smooth loop
        {%- endcomment -%}
        {% for block in section.blocks %}
          <div class="nsh-logo-item">
            {% if block.settings.logo != blank %}
              <img 
                src="{{ block.settings.logo | image_url: width: 400 }}" 
                alt="{{ block.settings.logo.alt | escape }}"
                loading="lazy"
              >
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
.nsh-logo-slider {
  width: 100%;
  overflow: hidden;
  padding: {{ section.settings.padding_vertical }}px 0;
}

.nsh-logo-wrapper {
  overflow: hidden;
  position: relative;
}

.nsh-logo-track {
  display: flex;
  align-items: center;
  gap: {{ section.settings.logo_gap }}px;
  width: max-content;
  animation: nshScroll {{ section.settings.speed }}s linear infinite;
}

.nsh-logo-item {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nsh-logo-item img {
  max-width: {{ section.settings.logo_width }}px;
  height: auto;
  object-fit: contain;
  transition: transform 0.3s ease;
}

.nsh-logo-item img:hover {
  transform: scale(1.05);
}

/* Animation */
@keyframes nshScroll {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

/* Responsive */
@media screen and (max-width: 768px) {
  .nsh-logo-slider {
    padding: {{ section.settings.padding_vertical_mobile }}px 0;
  }

  .nsh-logo-item img {
    max-width: {{ section.settings.logo_width_mobile }}px;
  }
}
</style>

{% schema %}
{
  "name": "NSH Logo Slider",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f8f8f8"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo Width (Desktop)",
      "min": 60,
      "max": 300,
      "step": 10,
      "default": 140
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Logo Width (Mobile)",
      "min": 40,
      "max": 200,
      "step": 10,
      "default": 100
    },
    {
      "type": "range",
      "id": "logo_gap",
      "label": "Gap Between Logos",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Slider Speed (Seconds)",
      "min": 5,
      "max": 60,
      "step": 1,
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical Padding (Desktop)",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_vertical_mobile",
      "label": "Vertical Padding (Mobile)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo Image"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "NSH Logo Slider",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}