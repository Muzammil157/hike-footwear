<section class="satisfied-testimonials">

    {% if section.settings.heading != blank %}
      <h2 class="testimonial-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="testimonial-grid">
      {% for block in section.blocks %}
        <div class="testimonial-card" {{ block.shopify_attributes }}>

          <!-- Stars -->
          <div class="testimonial-stars">
            {% for i in (1..block.settings.rating) %}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M16 6.28345C16 6.42478 15.9167 6.57878 15.75 6.74545L12.2593 10.1488L13.086 14.9568C13.0927 15.0015 13.096 15.0661 13.096 15.1495C13.0998 15.2709 13.0645 15.3903 12.9953 15.4901C12.962 15.5361 12.9177 15.573 12.8665 15.5974C12.8152 15.6219 12.7587 15.6331 12.702 15.6301C12.58 15.6301 12.452 15.5915 12.3173 15.5141L8 13.2461L3.68267 15.5155C3.54133 15.5921 3.41333 15.6308 3.298 15.6308C3.16333 15.6308 3.06267 15.5841 2.99533 15.4908C2.9259 15.391 2.89037 15.2716 2.894 15.1501C2.894 15.1115 2.90067 15.0475 2.914 14.9575L3.74067 10.1501L0.240667 6.74612C0.08 6.57212 0 6.41878 0 6.28345C0 6.04678 0.18 5.89878 0.538667 5.84145L5.36533 5.13945L7.52867 0.764784C7.65067 0.50145 7.80733 0.370117 8 0.370117C8.19267 0.370117 8.34933 0.50145 8.47133 0.764784L10.6347 5.13945L15.4613 5.84145C15.8207 5.89878 16 6.04678 16 6.28345Z" fill="#000000"></path></svg>
            {% endfor %}
          </div>

          <!-- Review Text -->
          {% if block.settings.review_text != blank %}
            <div class="testimonial-text">
              {{ block.settings.review_text }}
            </div>
          {% endif %}

          <!-- Reviewer Info -->
          <div class="reviewer-info">
            {% if block.settings.reviewer_image != blank %}
              <img 
                src="{{ block.settings.reviewer_image | image_url: width: 100 }}" 
                alt="{{ block.settings.reviewer_name }}"
                class="reviewer-image"
              >
            {% endif %}

            {% if block.settings.reviewer_name != blank %}
              <div class="reviewer-name">
                {{ block.settings.reviewer_name }}
              </div>
            {% endif %}
          </div>

          <!-- Separator -->
          <hr class="testimonial-separator">

          <!-- Product Info -->
          {% assign product = block.settings.product %}
          {% if product != blank %}
            <div class="testimonial-product">

              <div class="product-image">
                <img 
                  src="{{ product.featured_image | image_url: width: 150 }}" 
                  alt="{{ product.title }}"
                >
              </div>

              <div class="product-info">
                <div class="product-title">
                  {{ product.title }}
                </div>

                <div class="product-pricing">
                  <span class="product-price">
                    {{ product.price | money }}
                  </span>

                  {% if product.compare_at_price > product.price %}
                    <span class="product-compare">
                      {{ product.compare_at_price | money }}
                    </span>
                  {% endif %}
                </div>
              </div>

            </div>
          {% endif %}

        </div>
      {% endfor %}

  </div>
</section>

<style>
.satisfied-testimonials {
  padding: 64px 27px;
  background: rgb(248, 250, 248);
}

.testimonial-heading {
  text-align: left;
    margin: 0;
    margin-bottom: 48px;
    font-size: 36px;
    font-weight: 600;
}

.testimonial-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
}

.testimonial-card {
  padding: 25px;
    background: rgb(234, 238, 227);
    border-radius: 8px;
}

.testimonial-stars {
  color: #000;
  font-size: 18px;
  margin-bottom: 15px;
}

.testimonial-text {
  margin-bottom: 20px;
}

.reviewer-info {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12px;
  margin-bottom: 24px;
}

.reviewer-image {
  width: 45px;
  height: 45px;
  object-fit: cover;
  border-radius: 50%;
}

.reviewer-name {
  font-weight: 300;
  font-size: 14px;
}

.testimonial-separator {
  margin: 20px 0;
  border: none;
  border-top: 1px solid #e5e5e5;
}

.testimonial-product {
  display: flex;
  align-items: center;
  gap: 15px; /* 15px gap as requested */
  text-align: left;
}

.product-image img {
  width: 70px;
  height: auto;
}

.product-title {
  font-weight: 600;
  margin-bottom: 5px;
}

.product-pricing {
  display: flex;
  gap: 10px;
  align-items: center;
}

.product-compare {
  text-decoration: line-through;
  color: #888;
}

/* Responsive */
@media screen and (max-width: 990px) {
  .testimonial-grid {
    grid-template-columns: 1fr;
  }
}
</style>

{% schema %}
{
  "name": "Satisfied Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See why our customers are so satisfied"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "limit": 3,
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Star Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Text"
        },
        {
          "type": "image_picker",
          "id": "reviewer_image",
          "label": "Reviewer Image"
        },
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer Name"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Reviewed Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Satisfied Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}