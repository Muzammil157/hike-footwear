<section class="mb-custom-metrics">
  <div class="mb-custom-container">

    {% if section.settings.subheading != blank %}
      <p class="mb-custom-subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="mb-custom-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="mb-custom-grid">

      {% for block in section.blocks %}

      <div class="mb-custom-block"
           data-percentage="{{ block.settings.percentage }}"
           {{ block.shopify_attributes }}>

        {% if block.settings.icon != blank %}
        <img
          class="mb-custom-icon"
          src="{{ block.settings.icon | image_url: width: 120 }}"
          loading="lazy"
        >
        {% endif %}

        <p class="mb-custom-block-heading">
          {{ block.settings.block_heading }}
        </p>

        <div class="mb-custom-percentage">
          <span class="mb-custom-count">0</span>%
        </div>

        <p class="mb-custom-feature">
          {{ block.settings.feature }}
        </p>

        <div class="mb-custom-bars">

  <div class="mb-custom-bar">
    <div class="mb-custom-bar-fill bar1"></div>
  </div>

  <div class="mb-custom-bar">
    <div class="mb-custom-bar-fill bar2"></div>
  </div>

  <div class="mb-custom-bar">
    <div class="mb-custom-bar-fill bar3"></div>
  </div>

  <div class="mb-custom-bar">
    <div class="mb-custom-bar-fill bar4"></div>
  </div>

</div>

        <div class="mb-custom-description">
          {{ block.settings.description }}
        </div>

      </div>

      {% endfor %}

    </div>
  </div>
</section>


<style>

#shopify-section-{{ section.id }} .mb-custom-metrics {
  padding-inline: 27px;
  text-align: center;
}

#shopify-section-{{ section.id }} .mb-custom-container {
  max-width: 1400px;
  margin: 0 auto;
}

#shopify-section-{{ section.id }} .mb-custom-subheading {
  font-size: 16px;
  font-weight: 500;
  margin-bottom: 8px;
  text-align: center;
}

#shopify-section-{{ section.id }} .mb-custom-heading {
  font-size: 32px;
  font-weight: 700;
  margin-bottom: 40px;
  text-align: center;
}

#shopify-section-{{ section.id }} .mb-custom-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  justify-items: center;
  gap: 40px;
}

#shopify-section-{{ section.id }} .mb-custom-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

#shopify-section-{{ section.id }} .mb-custom-icon {
  width: 60px;
  margin-bottom: 10px;
}

#shopify-section-{{ section.id }} .mb-custom-block-heading {
  font-weight: 600;
  margin-bottom: 6px;
}

#shopify-section-{{ section.id }} .mb-custom-percentage {
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 4px;
}

#shopify-section-{{ section.id }} .mb-custom-feature {
  font-size: 14px;
  margin-bottom: 12px;
}

#shopify-section-{{ section.id }} .mb-custom-bars {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 6px;
  width: 100%;
  max-width: 220px;
  margin-bottom: 10px;
}

#shopify-section-{{ section.id }} .mb-custom-bar {
  height: 8px;
  background: #e5e5e5;
  border-radius: 6px;
  overflow: hidden;
}

#shopify-section-{{ section.id }} .mb-custom-bar-fill {
  height: 100%;
  width: 0%;
  transition: width 0.8s ease;
  border-radius: 6px;
}

#shopify-section-{{ section.id }} .bar1 {
  background: {{ section.settings.bar_color_1 }};
}

#shopify-section-{{ section.id }} .bar2 {
  background: {{ section.settings.bar_color_2 }};
}

#shopify-section-{{ section.id }} .bar3 {
  background: {{ section.settings.bar_color_3 }};
}

#shopify-section-{{ section.id }} .bar4 {
  background: {{ section.settings.bar_color_4 }};
}

#shopify-section-{{ section.id }} .mb-custom-description {
  font-size: 14px;
  color: #555;
}

/* MOBILE */
@media (max-width: 768px) {
  #shopify-section-{{ section.id }} .mb-custom-metrics {
    padding-inline: 16px;
  }
  #shopify-section-{{ section.id }} .mb-custom-grid {
    grid-template-columns: 1fr;
    gap: 28px;
  }
}

</style>


<script>

document.addEventListener("DOMContentLoaded", function(){

  const section = document.querySelector(".mb-custom-metrics");
  const blocks = section.querySelectorAll(".mb-custom-block");

  let animated = false;

  function animateMetrics(){

    if(animated) return;

    const rect = section.getBoundingClientRect();

    if(rect.top < window.innerHeight){

      animated = true;

      blocks.forEach(block => {

        const percentage = parseInt(block.dataset.percentage);
        const counter = block.querySelector(".mb-custom-count");
        const bars = block.querySelectorAll(".mb-custom-bar-fill");

        let current = 0;

        const counterInterval = setInterval(()=>{

          if(current >= percentage){
            clearInterval(counterInterval);
          }else{
            current++;
            counter.innerText = current;
          }

        },20);


        const barPercent = percentage / 4;

        bars.forEach((bar,index)=>{

          let fill = (percentage - (index*25));

          if(fill > 25) fill = 25;
          if(fill < 0) fill = 0;

          const width = (fill/25)*100;

          setTimeout(()=>{
            bar.style.width = width + "%";
          }, index * 200);

        });

      });

    }

  }

  window.addEventListener("scroll", animateMetrics);

  animateMetrics();

});

</script>



{% schema %}
{
  "name": "Feature Metrics",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "color",
      "id": "bar_color_1",
      "label": "Bar 1 color",
      "default": "#ff7a00"
    },
    {
      "type": "color",
      "id": "bar_color_2",
      "label": "Bar 2 color",
      "default": "#ffc400"
    },
    {
      "type": "color",
      "id": "bar_color_3",
      "label": "Bar 3 color",
      "default": "#a24a3a"
    },
    {
      "type": "color",
      "id": "bar_color_4",
      "label": "Bar 4 color",
      "default": "#1db954"
    }
  ],

  "blocks":[
    {
      "type":"metric",
      "name":"Metric block",
      "limit":4,
      "settings":[
        {
          "type":"image_picker",
          "id":"icon",
          "label":"Icon"
        },
        {
          "type":"text",
          "id":"block_heading",
          "label":"Heading"
        },
        {
          "type":"number",
          "id":"percentage",
          "label":"Percentage",
          "default":80
        },
        {
          "type":"text",
          "id":"feature",
          "label":"Feature word"
        },
        {
          "type":"richtext",
          "id":"description",
          "label":"Description"
        }
      ]
    }
  ],

  "presets":[
    {
      "name":"Feature Metrics",
      "blocks":[
        {"type":"metric"},
        {"type":"metric"},
        {"type":"metric"},
        {"type":"metric"}
      ]
    }
  ]
}
{% endschema %}