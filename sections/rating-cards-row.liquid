<section class="rating-cards-section">

    {% if section.settings.heading != blank %}
      <div class="rating-heading-wrapper">
        <h2 class="rating-heading">
          {{ section.settings.heading }}
        </h2>
      </div>
    {% endif %}

    <div class="rating-cards-wrapper">
      {% for block in section.blocks %}
        <div class="rating-card" {{ block.shopify_attributes }}>

          {% if block.settings.image != blank %}
            <div class="card-image">
              <img 
                src="{{ block.settings.image | image_url: width: 600 }}" 
                alt="rating image"
              >
            </div>
          {% endif %}

          <div class="card-rating-row">

            {% if block.settings.rating_text != blank %}
              <div class="custom-rating-text">
                {{ block.settings.rating_text }}
              </div>
            {% endif %}

            <div class="rating-stars">
              {% for i in (1..block.settings.rating) %}
                <svg class="w-4 h-4 fill-yellow" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"></path></svg>
              {% endfor %}
            </div>

          </div>

        </div>
      {% endfor %}
    </div>

</section>

<style>
.rating-cards-section * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

.rating-cards-section {
  padding: 48px 51px 48px 51px; 
  display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background: #f8faf8;
    gap: 24px;
}

/* Heading */
.rating-heading-wrapper {
  max-width: 90rem;
  {% comment %} margin: 0 auto 40px auto; {% endcomment %}
  text-align: center;
}

.rating-heading {
  margin: 0;
  font-size: 36px;
    font-weight: 600;
    line-height: 40px;
}

/* Cards Wrapper */
.rating-cards-wrapper {
  display: flex;
  justify-content: center;
  flex-direction: row;
  gap: 20px;
}

/* Card */
.rating-card {
  flex: 1;
  background: #eaeee3;
  border-radius: {{ section.settings.card_radius }}px;
  padding: 16px 48px;
  max-width: max-content;
}

.card-image {
    max-width: 28rem;
    margin: auto;
}

/* Image */
.card-image img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 4px;
}

/* Rating Row */
.card-rating-row {
  margin-top: 15px;
  display: flex;
  justify-content: center;
  gap: 10px;
  align-items: center;
}

/* Rating Text */
.custom-rating-text {
  margin-right: 5px; /* 5px gap */
}

/* Stars */
.rating-stars {
  color: #FFC107; /* Yellow stars */
  font-size: 18px;
  display: flex;
}

.rating-stars svg {
  width: 20px;
}

/* Mobile */
@media screen and (max-width: 749px) {
  .rating-card {
    padding: 10px;
  }

  .rating-stars {
    font-size: 16px;
  }
}
</style>

{% schema %}
{
  "name": "Rating Cards Row",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Ratings"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card Border Radius (px)",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Rating Card",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "rating_text",
          "label": "Rating Text",
          "default": "Excellent"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rating Cards Row",
      "blocks": [
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}