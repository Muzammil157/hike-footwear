{% style %}
.shokutwa-hero {
  background-color: {{ section.settings.background_color }};
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}

.custom-page-width {
  max-width: 100%;
}

.shokutwa-hero__container {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  align-items: center;
  padding-inline: 1.2rem;
  padding-block: 2.4rem;
}

.custom-left-inner {
  max-width: 560px;
  margin-inline: auto;
}

.shokutwa-hero__content {
  /* max-width: 600px; */
  padding: 6.4rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  background-color: #F8FAF8;
}

.shokutwa-stars {
  color: {{ section.settings.star_color }};
  font-size: 18px;
  margin-bottom: 12px;
}

.shokutwa-heading {
  font-size: 48px;
  font-weight: 700;
  margin: 0;
  line-height: 1.1;
}

.shokutwa-small-heading {
  font-size: 22px;
  font-weight: 600;
  margin-top: 10px;
}

.shokutwa-subheading {
  font-size: 18px;
  margin-top: 15px;
}

.shokutwa-icons {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin: 30px 0;
}

.shokutwa-icon-item {
  text-align: center;
}

.shokutwa-icon-item img {
  width: 60px;
  height: 60px;
  object-fit: contain;
  margin-bottom: 10px;
}

.shokutwa-button {
  display: inline-block;
  padding: 14px 28px;
  background-color: {{ section.settings.button_bg }};
  color: {{ section.settings.button_text }};
  text-decoration: none;
  font-weight: 600;
  text-transform: uppercase;
  border-radius: 6px;
  transition: 0.3s ease;
}

.shokutwa-button:hover {
  opacity: 0.9;
}

.shokutwa-hero__image img {
  width: 100%;
  height: auto;
  border-radius: 10px;
}

/* Mobile */
@media screen and (max-width: 768px) {
  .shokutwa-hero__container {
    grid-template-columns: 1fr;
  }

  .shokutwa-hero__image {
    order: -1;
  }

  .shokutwa-heading {
    font-size: 34px;
  }

  .shokutwa-icons {
    grid-template-columns: repeat(2, 1fr);
  }
}
{% endstyle %}

<section class="shokutwa-hero">
  <div class="custom-page-width">
    <div class="shokutwa-hero__container">

      <!-- LEFT SIDE CONTENT -->
      <div class="shokutwa-hero__content">
        <div class="custom-left-inner">

        {% if section.settings.show_reviews %}
          <div class="shokutwa-stars">
            ★★★★★
            <span style="color: {{ section.settings.review_text_color }};">
              {{ section.settings.review_text }}
            </span>
          </div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h1 class="shokutwa-heading">
            {{ section.settings.heading }}
          </h1>
        {% endif %}

        {% if section.settings.small_heading != blank %}
          <div class="shokutwa-small-heading">
            {{ section.settings.small_heading }}
          </div>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div class="shokutwa-subheading">
            {{ section.settings.subheading }}
          </div>
        {% endif %}

        <!-- ICON BLOCKS -->
        <div class="shokutwa-icons">
          {% for block in section.blocks %}
            {% if block.type == 'icon_block' %}
              <div class="shokutwa-icon-item" {{ block.shopify_attributes }}>
                {% if block.settings.icon != blank %}
                  <img src="{{ block.settings.icon | image_url: width: 100 }}" alt="{{ block.settings.text }}">
                {% endif %}
                <div>{{ block.settings.text }}</div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <!-- BUTTON -->
        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link }}" class="shokutwa-button">
            {{ section.settings.button_label }}
          </a>
        {% endif %}
        </div>
      </div>

      <!-- RIGHT SIDE IMAGE -->
      <div class="shokutwa-hero__image">
        {% if section.settings.banner_image != blank %}
          <img 
            src="{{ section.settings.banner_image | image_url: width: 1600 }}" 
            alt="Hero Banner"
          >
        {% endif %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shokutwa Lagoon Hero",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show Reviews",
      "default": true
    },
    {
      "type": "text",
      "id": "review_text",
      "label": "Review Text",
      "default": "4000+ Lives Improved"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#EBBF20"
    },
    {
      "type": "color",
      "id": "review_text_color",
      "label": "Review Text Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Healthy Barefoot Shoes"
    },
    {
      "type": "text",
      "id": "small_heading",
      "label": "Small Heading",
      "default": "Healthy Barefoot Shoes"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Your path to pain-free walking"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Right Side Banner Image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Clearance Sale →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background",
      "default": "#343f20"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#F8FAF8"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "icon_block",
      "name": "Icon Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Icon Text",
          "default": "Wide Toe Box"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Shokutwa Lagoon Hero",
      "category": "Custom"
    }
  ]
}
{% endschema %}