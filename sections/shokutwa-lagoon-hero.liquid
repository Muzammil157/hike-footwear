            <span style="color: {{ section.settings.review_text_color }};">
              {{ section.settings.review_text }}
            </span>
          </div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h1 class="shokutwa-heading">
            {{ section.settings.heading }}
          </h1>
        {% endif %}

        {% if section.settings.small_heading != blank %}
          <div class="shokutwa-small-heading">
            {{ section.settings.small_heading }}
          </div>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div class="shokutwa-subheading">
            {{ section.settings.subheading }}
          </div>
        {% endif %}

        <!-- ICON BLOCKS -->
        <div class="shokutwa-icons">
          {% for block in section.blocks %}
            {% if block.type == 'icon_block' %}
              <div class="shokutwa-icon-item" {{ block.shopify_attributes }}>
                {% if block.settings.icon != blank %}
                  <img src="{{ block.settings.icon | image_url: width: 100 }}" alt="{{ block.settings.text }}">
                {% endif %}
                <div>{{ block.settings.text }}</div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <!-- BUTTON -->
        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link }}" class="shokutwa-button custom-anchor">
            {{ section.settings.button_label }}
          </a>
        {% endif %}
        </div>
      </div>

      <!-- RIGHT SIDE IMAGE -->
      <div class="shokutwa-hero__image">
        {% if section.settings.banner_image != blank %}
          <img 
            src="{{ section.settings.banner_image | image_url: width: 1600 }}" 
            alt="Hero Banner"
          >
        {% endif %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shokutwa Lagoon Hero",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show Reviews",
      "default": true
    },
    {
      "type": "text",
      "id": "review_text",
      "label": "Review Text",
      "default": "4000+ Lives Improved"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#EBBF20"
    },
    {
      "type": "color",
      "id": "review_text_color",
      "label": "Review Text Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Healthy Barefoot Shoes"
    },
    {
      "type": "text",
      "id": "small_heading",
      "label": "Small Heading",
      "default": "Healthy Barefoot Shoes"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Your path to pain-free walking"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Right Side Banner Image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Clearance Sale →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background",
      "default": "#343f20"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#F8FAF8"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "icon_block",
      "name": "Icon Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Icon Text",
          "default": "Wide Toe Box"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Shokutwa Lagoon Hero",
      "category": "Custom"
    }
  ]
}
{% endschema %}