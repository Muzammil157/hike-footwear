{% style %}
.shokutwa-hero {
  background-color: {{ section.settings.background_color }};
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}

.shokutwa-hero__container > * {
  min-width: 0;
}

.custom-page-width {
  max-width: 100%;
}

.shokutwa-hero__container {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  align-items: center;
  padding-inline: 1.2rem;
  /* padding-block: 2.4rem; */
  gap: 12px;
}

.custom-left-inner {
  max-width: 560px;
  margin-inline: auto;
}

.shokutwa-hero__content {
  padding: 6.4rem;
  border-radius: 6px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  background-color: #F8FAF8;
  letter-spacing: normal;
}

.shokutwa-stars {
  color: {{ section.settings.star_color }};
  padding: 8px 16px;
  background-color: #fff;
  border-radius: 32px;
  display: flex;
  width: max-content;
  gap: 8px;
  align-items: center;
  font-size: 14px;
  line-height: 20px;
}

.stars-inner {
  display: flex;
  align-items: center;
  gap: 4px;
}

.shokutwa-heading {
  font-size: 48px;
  font-weight: 600;
  margin: 0;
  line-height: 72px;
}

.shokutwa-small-heading {
  font-size: 20px;
  font-weight: 400;
  color: #000;
  margin: 0;
  line-height: 28px;
}

.shokutwa-subheading {
  font-size: 18px;
  margin-top: 15px;
}

.shokutwa-icons {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  padding-block: 16px;
  margin-top: 12px;
}

.shokutwa-icon-item {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.shokutwa-icon-item img {
  width: 80px;
  height: 80px;
  object-fit: cover;
}

.shokutwa-icon-item div {
  font-size: 16px;
    line-height: 24px;
    font-weight: 500;
    color: #000;
}

.shokutwa-button {
  background-color: {{ section.settings.button_bg }};
  color: {{ section.settings.button_text }};
}

.shokutwa-button:hover {
  opacity: 0.9;
}

.shokutwa-hero__image img {
  width: 100%;
  height: auto;
  /* border-radius: 10px; */
}

/* Mobile */
@media screen and (max-width: 768px) {
  .shokutwa-hero__container {
    grid-template-columns: 1fr;
  }

  .shokutwa-hero__content {
    padding: 16px;
  }

  .shokutwa-hero__image {
    order: -1;
  }

  .shokutwa-icon-item {
    flex-direction: row;
  }

  .shokutwa-icon-item img {
    width: 60px;
  }

  .shokutwa-heading {
    font-size: 34px;
    line-height: 1.5;
  }

  .shokutwa-icons {
    grid-template-columns: repeat(2, 1fr);
  }
}
{% endstyle %}

<section class="shokutwa-hero">
  <div class="custom-page-width">
    <div class="shokutwa-hero__container">

      <!-- LEFT SIDE CONTENT -->
      <div class="shokutwa-hero__content">
        <div class="custom-left-inner">

