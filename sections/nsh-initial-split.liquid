{% comment %}
NSH Initial Split Section
{% endcomment %}

<section 
  class="nsh-initial-split" 
  style="background-color: {{ section.settings.bg_color }};"
>
  <div class="page-width">
    <div class="nsh-initial-wrapper">

      <!-- LEFT SIDE -->
      <div class="nsh-initial-left">

        {% if section.settings.heading != blank %}
          <h2 class="nsh-initial-heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div class="nsh-initial-subheading">
            {{ section.settings.subheading }}
          </div>
        {% endif %}

        {% if section.settings.left_image != blank %}
          <div class="nsh-initial-left-image">
            <img 
              src="{{ section.settings.left_image | image_url: width: 800 }}"
              alt="{{ section.settings.left_image.alt | escape }}"
              loading="lazy"
            >
          </div>
        {% endif %}

      </div>

      <!-- RIGHT SIDE -->
      <div class="nsh-initial-right">
        {% if section.settings.right_image != blank %}
          <img 
            src="{{ section.settings.right_image | image_url: width: 1000 }}"
            alt="{{ section.settings.right_image.alt | escape }}"
            loading="lazy"
          >
        {% endif %}
      </div>

    </div>
  </div>
</section>

<style>
.nsh-initial-split {
  padding: {{ section.settings.padding_vertical }}px 0;
}

.nsh-initial-wrapper {
  display: flex;
  align-items: center;
  gap: 60px;
}

.nsh-initial-left,
.nsh-initial-right {
  flex: 1;
}

/* LEFT SIDE */
.nsh-initial-heading {
  margin-bottom: 15px;
}

.nsh-initial-subheading {
  margin-bottom: 25px;
  opacity: 0.8;
}

.nsh-initial-left-image img {
  width: 100%;
  height: auto;
  border-radius: {{ section.settings.image_radius }}px;
}

/* RIGHT SIDE */
.nsh-initial-right img {
  width: 100%;
  height: auto;
  border-radius: {{ section.settings.image_radius }}px;
}

/* MOBILE RESPONSIVE */
@media screen and (max-width: 768px) {
  .nsh-initial-wrapper {
    flex-direction: column;
    gap: 40px;
  }

  .nsh-initial-left {
    order: 1;
  }

  .nsh-initial-right {
    order: 2;
  }

  .nsh-initial-split {
    padding: {{ section.settings.padding_vertical_mobile }}px 0;
  }
}
</style>

{% schema %}
{
  "name": "NSH Initial Split",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Main Heading Here"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Your supporting subheading text goes here."
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left Side Image (Under Text)"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right Side Image"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image Border Radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical Padding (Desktop)",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_vertical_mobile",
      "label": "Vertical Padding (Mobile)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "NSH Initial Split"
    }
  ]
}
{% endschema %}